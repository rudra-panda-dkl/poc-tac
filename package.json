{
  "name": "tac-poc",
  "private": true,
  "version": "0.0.0",
  "description": "Temporal Agent Credential (TAC) proof-of-concept — 001-grant, 002-transact, 003-revoke",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.2.0",
    "prettier": "^3.3.3"
  }
}
